<Page x:Class="PizzaTimeApp.Views.MyOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои заказы" Height="450" Width="800">
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#333" Padding="10" Grid.Row="0">
            <Grid>
                <Button Content="Назад" Width="100" HorizontalAlignment="Left" Click="BtnBack_Click"/>
                <TextBlock Text="Мои заказы" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
        <DataGrid x:Name="MyOrdersGrid" Grid.Row="1" Margin="20" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                  GridLinesVisibility="All" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding order_id}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding order_date}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding total_amount}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>