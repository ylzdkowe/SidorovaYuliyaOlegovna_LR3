<Page x:Class="PizzaTimeApp.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заказы" Height="450" Width="800">
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#333" Padding="10" Grid.Row="0">
            <Grid>
                <Button Content="Назад" Width="100" HorizontalAlignment="Left" Click="BtnBack_Click"/>
                <TextBlock Text="Управление заказами" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <Button Content="Обновить" Width="120" Height="35" Margin="0,0,10,0" Click="BtnRefresh_Click"/>
                <Button x:Name="BtnDeleteOrder" Content="Удалить выбранный" Width="150" Height="35" Click="BtnDelete_Click" Background="#C00" Foreground="White"/>
            </StackPanel>

            <DataGrid x:Name="OrdersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                      GridLinesVisibility="All" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding order_id}" Width="50"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Client.last_name}" Width="150"/>
                    <DataGridTextColumn Header="Курьер" Binding="{Binding Courier.last_name}" Width="150"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding order_date}" Width="150"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="100"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding total_amount}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>