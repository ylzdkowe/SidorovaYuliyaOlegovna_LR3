<Page x:Class="PizzaTimeApp.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация" Height="450" Width="800">
    <Grid Background="#F0F0F0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Вход в систему PizzaTime" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLogin" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="30" Margin="0,0,0,20"/>

            <Button Content="Войти" Height="35" Click="BtnLogin_Click" Margin="0,0,0,10"/>
            <Button Content="Регистрация" Height="35" Click="BtnRegister_Click"/>
        </StackPanel>
    </Grid>
</Page>